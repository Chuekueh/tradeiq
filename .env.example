# OpenAI
RAG_OPENAI_API_KEY=sk-your-api-key-here
RAG_OPENAI_MODEL=gpt-4o-mini

# Embeddings
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector Store
RAG_CHROMA_PERSIST_DIR=./data/chroma_db
RAG_CHROMA_COLLECTION_NAME=financial_knowledge_base

# Retrieval
RAG_RETRIEVAL_TOP_K=5
RAG_RERANK_TOP_K=3
RAG_HYBRID_SEARCH_ALPHA=0.7

# Chunking
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50

# API
RAG_API_HOST=0.0.0.0
RAG_API_PORT=8000

# SEC EDGAR (email required by EDGAR fair access policy)
RAG_SEC_EDGAR_USER_AGENT=TradeIQ research@example.com
